DATABASE_URL=postgresql://ops_composer:ops_composer@localhost:5432/ops_composer
APP_ENV=development
APP_LOG_LEVEL=DEBUG
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_SESSION_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=
APP_SESSION_TTL_SECONDS=1209600
APP_AUTH_RATE_LIMIT_SECRET=development-only-auth-rate-limit-secret
APP_AUTH_LOGIN_USERNAME_IP_LIMIT=5
APP_AUTH_LOGIN_USERNAME_IP_WINDOW_SECONDS=300
APP_AUTH_LOGIN_IP_LIMIT=30
APP_AUTH_LOGIN_IP_WINDOW_SECONDS=300
OPS_COMPOSER_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OPS_COMPOSER_MASTER_KEY_VERSION=1
OPS_COMPOSER_AUDIT_RETENTION_DAYS=180
OPS_COMPOSER_WEB_SHELL_MAX_SESSIONS=5
OPS_COMPOSER_WEB_SHELL_IDLE_TIMEOUT_SECONDS=1800
OPS_COMPOSER_WEB_SHELL_MAX_DURATION_SECONDS=28800
OPS_COMPOSER_PLAYBOOK_WORKSPACE=../playbooks
OPS_COMPOSER_PLAYBOOK_SOURCE_MODE=both
OPS_COMPOSER_RUNTIME_DIR=/tmp/ops-composer/runtime
OPS_COMPOSER_STATIC_DIR=../frontend/dist
