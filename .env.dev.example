# Development Compose: all published ports stay on loopback by default.
DEV_FRONTEND_BIND_HOST=127.0.0.1
DEV_FRONTEND_PORT=5173
DEV_API_BIND_HOST=127.0.0.1
DEV_API_PORT=8000
DEV_DB_BIND_HOST=127.0.0.1
DEV_DB_PORT=5432
DEV_APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_AUTH_RATE_LIMIT_SECRET=development-only-auth-rate-limit-secret
DEV_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_LOG_LEVEL=DEBUG
OPS_COMPOSER_AUDIT_RETENTION_DAYS=180
OPS_COMPOSER_WEB_SHELL_MAX_SESSIONS=5
OPS_COMPOSER_WEB_SHELL_IDLE_TIMEOUT_SECONDS=1800
OPS_COMPOSER_WEB_SHELL_MAX_DURATION_SECONDS=28800
OPS_COMPOSER_PLAYBOOK_SOURCE_MODE=both
