# Production Compose. Copy to .env and replace every blank/change-me value.
APP_ENV=production
APP_LOG_LEVEL=INFO
POSTGRES_DB=ops_composer
POSTGRES_USER=ops_composer
POSTGRES_PASSWORD=change-me-database-password
# Percent-encode reserved characters from POSTGRES_PASSWORD in this URL.
DATABASE_URL=postgresql://ops_composer:change-me-database-password@db:5432/ops_composer

# The public HTTPS origin seen by the browser. TLS termination remains deployment-owned.
APP_ALLOWED_ORIGINS=https://ops.example.com
APP_SESSION_COOKIE_SECURE=true
APP_AUTH_RATE_LIMIT_SECRET=
FORWARDED_ALLOW_IPS=

# Generate with: openssl rand -base64 32
OPS_COMPOSER_MASTER_KEY=
OPS_COMPOSER_MASTER_KEY_VERSION=1
OPS_COMPOSER_AUDIT_RETENTION_DAYS=180
# database, mount, or both. Database Playbooks are Web-managed; mount is read-only.
OPS_COMPOSER_PLAYBOOK_SOURCE_MODE=both

APP_BIND_HOST=127.0.0.1
APP_PORT=8080
POSTGRES_DATA_DIR=./volumes/postgres
PLAYBOOK_WORKSPACE=./playbooks
OPS_COMPOSER_IMAGE=ops-composer:local
